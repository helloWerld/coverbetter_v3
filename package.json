{
	"name": "coverbetter",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"test": "vitest run",
		"test:watch": "vitest",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply coverbetter --local",
		"db:migrate:remote": "wrangler d1 migrations apply coverbetter --remote"
	},
	"dependencies": {
		"@clerk/nextjs": "^7.9.26",
		"@opennextjs/cloudflare": "^1.20.17",
		"drizzle-orm": "^0.45.4",
		"embla-carousel-autoplay": "^8.3.1",
		"embla-carousel-react": "^8.3.1",
		"next": "^16.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.3.0",
		"server-only": "^0.0.1"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"daisyui": "^4.12.14",
		"drizzle-kit": "^0.31.11",
		"postcss": "^8",
		"tailwindcss": "^3.4.1",
		"typescript": "^5",
		"vitest": "^5.1.0",
		"wrangler": "^4.162.0"
	}
}
